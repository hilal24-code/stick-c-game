<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GamepadBridge.Desktop</RootNamespace>
    <AssemblyName>GamepadBridge</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GamepadBridge.Protocol\GamepadBridge.Protocol.csproj" />
    <ProjectReference Include="..\GamepadBridge.Core\GamepadBridge.Core.csproj" />
  </ItemGroup>

</Project>
