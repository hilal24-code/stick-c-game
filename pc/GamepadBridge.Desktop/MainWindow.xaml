<Window x:Class="GamepadBridge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GamepadBridge" Width="860" Height="600" MinWidth="760" MinHeight="540"
        Background="#111318" Foreground="White" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#1B1F27"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA0A6"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2A3040"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#38405A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Kiri: judul, status, input langsung ===== -->
        <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="🎮" FontSize="34" VerticalAlignment="Center"/>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="GamepadBridge" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Server PC untuk gamepad HP lewat Bluetooth" FontSize="12"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Status -->
            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="16" Height="16" Fill="#9AA0A6" VerticalAlignment="Center"/>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock x:Name="StatusTitle" Text="Memulai..." FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="StatusDetailText" Text="" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Input langsung -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Input langsung" FontSize="14" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Canvas x:Name="LStick" Width="100" Height="100" Margin="0,0,16,0">
                            <Ellipse Width="100" Height="100" Stroke="#44FFFFFF" StrokeThickness="2" Fill="#14FFFFFF"/>
                            <Ellipse x:Name="LKnob" Width="30" Height="30" Fill="#3DD6F5" Canvas.Left="35" Canvas.Top="35"/>
                        </Canvas>
                        <Canvas x:Name="RStick" Width="100" Height="100" Margin="0,0,24,0">
                            <Ellipse Width="100" Height="100" Stroke="#44FFFFFF" StrokeThickness="2" Fill="#14FFFFFF"/>
                            <Ellipse x:Name="RKnob" Width="30" Height="30" Fill="#3DD6F5" Canvas.Left="35" Canvas.Top="35"/>
                        </Canvas>
                        <StackPanel VerticalAlignment="Center" Width="150">
                            <TextBlock Text="L2" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <ProgressBar x:Name="LtBar" Minimum="0" Maximum="255" Height="8" Foreground="#3DD6F5"
                                         Background="#2A3040" BorderThickness="0" Margin="0,2,0,12"/>
                            <TextBlock Text="R2" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <ProgressBar x:Name="RtBar" Minimum="0" Maximum="255" Height="8" Foreground="#3DD6F5"
                                         Background="#2A3040" BorderThickness="0" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <WrapPanel x:Name="ButtonPanel" Margin="-3,14,0,0"/>
                </StackPanel>
            </Border>

            <!-- Statistik -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Paket diterima" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="PacketsText" Text="0" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Byte dibuang" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="DroppedText" Text="0" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Getaran dari game" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="RumbleText" Text="0%" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ===== Kanan: pengaturan dan log ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Pengaturan" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <CheckBox x:Name="AutoStartCheck" Content="Jalankan saat Windows menyala"/>
                    <TextBlock Text="Saat otomatis, aplikasi langsung bersembunyi di ikon tray." FontSize="11"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="22,2,0,12"/>
                    <Button x:Name="RestartBtn" Content="Mulai ulang Bluetooth" Style="{StaticResource PillButton}"
                            Click="Restart_Click" Margin="0,0,0,8"/>
                    <Button x:Name="HideBtn" Content="Sembunyikan ke tray" Style="{StaticResource PillButton}"
                            Click="Hide_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Log" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" Background="#0D0F13" Foreground="#B8C0CC"
                             FontFamily="Consolas" FontSize="11" BorderThickness="0" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="8"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
